# Use an official Node.js runtime as a parent image.
# Using a specific version like 18-alpine is good practice for stability and small size.
FROM node:18-alpine

# Set the working directory in the container
WORKDIR /app

# Copy package manifests and Prisma schema before installing dependencies.
# The package postinstall script runs "prisma generate", so the schema must
# already exist inside the image at that point.
COPY package*.json ./
COPY prisma ./prisma/

# Install only production dependencies. Prisma Client is generated by postinstall.
RUN npm install --omit=dev

# Copy the rest of the application's source code from your computer to the container
COPY . .

# Make the app's port available to the outside world
EXPOSE 5000

# Define the command to run the app
CMD [ "node", "index.js" ]
